# Copy to .env (same directory as docker-compose.yml) to pass secrets into
# the containers. Everything else needed to run `docker compose up` is
# already wired up in docker-compose.yml with local-dev defaults.

# Needed for the Gemini CV extraction to work end-to-end; without it, OCR
# falls back to Tesseract only (see backend/app/Services/Ocr/GeminiCvExtractor.php).
GEMINI_API_KEY=
