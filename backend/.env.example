APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Complaint alerts. Every Administrator with an email on file is notified the
# moment a candidate reports a problem. Accounts here are phone-first, so an
# administrator without an email is normal — this ops mailbox is what stops a
# deployment from having no recipients at all.
# COMPLAINT_ALERT_EMAIL=ops@example.com
# Optional and additive: a Slack incoming webhook, which is the channel that
# actually reaches somebody within a minute.
# COMPLAINT_SLACK_WEBHOOK=
# Where an alert links to. The API and the admin SPA are different origins, so
# this cannot be derived from APP_URL.
# ADMIN_DASHBOARD_URL=http://localhost:5173

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# CV extraction (Gemini). Without a key, PDFs cannot be read at all —
# Tesseract handles images only, and the job falls back to it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# OCR pipeline. Below the threshold a document is not discarded: whatever was
# read is kept and the candidate is asked to check it. Only a document that
# gave up nothing usable is marked failed and asked for a new photo.
# OCR_CONFIDENCE_THRESHOLD=60
# A weak local (Tesseract) pass is sent to Gemini for a paid second opinion,
# and the better of the two results wins. Inert without GEMINI_API_KEY.
# OCR_ESCALATE_TO_CLOUD=true
# Tesseract language packs to OCR with. Without these it assumes English and
# mangles French, Arabic and German scans. Install with e.g.
#   dnf install tesseract-langpack-fra tesseract-langpack-ara tesseract-langpack-deu
# Packs that are not installed are dropped from the list at runtime.
# TESSERACT_LANGUAGES=eng+fra+ara+deu

# OTP delivery. `log` writes the code to storage/logs/laravel.log and, in local
# or testing only, echoes it back in the API response — no provider account
# needed to sign in. NEVER leave OTP_CHANNELS=log in production: every real
# candidate's code would be written to disk in plain text (the response-body
# echo is separately blocked outside local/testing regardless of this value).
# For production set OTP_CHANNELS=evolution,sms (self-hosted Evolution Go
# gateway) or OTP_CHANNELS=whatsapp,sms (Meta Cloud API): WhatsApp is tried
# first and SMS is the fallback. Channels missing credentials are skipped,
# not failed.
OTP_CHANNELS=log
# OTP_TTL_MINUTES=10
# OTP_RESEND_COOLDOWN=60
# OTP_MAX_SENDS=5
# OTP_SEND_WINDOW_MINUTES=60
# OTP_MAX_ATTEMPTS=5
# Echo the log channel's code back in the API response as `debug_otp_code`.
# Only ever honoured when APP_ENV is local/testing, regardless of this value —
# leaving it set to true in a production .env has no effect. Defaults to true
# in local, false everywhere else; uncomment only to opt out locally.
# OTP_EXPOSE_CODE=true

# Administrator allowlist. These numbers are granted the Administrator role on
# their first OTP request, which is what makes a fresh deployment reachable:
# there are no passwords, every other role is granted from the /admin console,
# and getting into that console requires the role. Comma-separated; a national
# Moroccan number is understood as written, so "0632594914" and "+212632594914"
# are the same entry (set ADMIN_PHONE_COUNTRY for another default).
#
# The number is not a secret — the OTP sent to that handset is what proves it
# is yours. Removing an entry does not revoke anything: the list only ever
# adds, so take the role away in the console instead.
ADMIN_PHONES=
# ADMIN_PHONE_COUNTRY=+212

# Referral programme. What an agent earns per qualifying referral (the moment
# their candidate submits a completed dossier), and how long a rotated-away QR
# token keeps attributing — printed codes cannot be recalled the day an agent
# presses "generate a new code". Set the grace to 0 to rotate immediately.
# REFERRAL_COMMISSION_AMOUNT=150
# REFERRAL_CURRENCY=MAD
# REFERRAL_TOKEN_GRACE_DAYS=30

# Meta WhatsApp Business Cloud API. The template must be approved and of
# category AUTHENTICATION — free-form text is not deliverable at sign-in time.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=otp_code
WHATSAPP_OTP_TEMPLATE_LANGUAGE=en
# Set false if the approved template has no one-tap copy-code button.
# WHATSAPP_OTP_COPY_CODE_BUTTON=true

# Evolution Go — self-hosted WhatsApp gateway paired by QR, so no Meta Business
# account or approved template is needed. EVOLUTION_INSTANCE_TOKEN is the token
# you passed to POST /instance/create, not the server's GLOBAL_API_KEY.
EVOLUTION_BASE_URL=http://localhost:4000
EVOLUTION_INSTANCE_TOKEN=
# EVOLUTION_OTP_MESSAGE="Your verification code is :code. It expires in :minutes minutes."
# Set false to skip the /user/check pre-flight (saves a round-trip, but a
# candidate with no WhatsApp account then never falls through to SMS).
# EVOLUTION_CHECK_NUMBER=true
# EVOLUTION_TIMEOUT=15

# Twilio SMS fallback. Prefer a Messaging Service over a bare from-number:
# it picks a sender that is registered for the destination country.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM=
