# The API as one Heroku container (heroku.yml at the repository root; runbook
# in deploy/HEROKU.md). Same PHP, OCR and Whisper stack as Dockerfile.prod —
# keep the two in step, the PHP pin above all — but nginx runs inside the
# image instead of in a container of its own, because a dyno is one container
# listening on $PORT.
#
# Heroku runs the container as an arbitrary non-root user and ignores USER,
# EXPOSE and VOLUME, so everything written at run time is world-writable and
# nothing is expected to persist: uploads go to buckets (FILE_STORAGE=s3).
FROM php:8.4.27-fpm-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
        git unzip curl ca-certificates nginx \
        libzip-dev libpng-dev libjpeg62-turbo-dev libfreetype6-dev libicu-dev libonig-dev \
        default-mysql-client \
        tesseract-ocr tesseract-ocr-eng tesseract-ocr-fra tesseract-ocr-ara tesseract-ocr-deu \
        python3 python3-venv ffmpeg \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j"$(nproc)" pdo_mysql mbstring bcmath gd zip pcntl intl \
    && python3 -m venv /opt/whisper-venv \
    && /opt/whisper-venv/bin/pip install --no-cache-dir 'faster-whisper==1.2.1' 'av>=15,<18' \
    && rm -rf /var/lib/apt/lists/*

# The Whisper model ships in the image: on the Compose deploy it is downloaded
# once into a volume, but a dyno would fetch it again after every restart.
ENV PATH="/opt/whisper-venv/bin:$PATH" \
    HF_HOME=/opt/whisper-models
RUN python3 -c 'from faster_whisper import WhisperModel; WhisperModel("base", device="cpu", compute_type="int8")' \
    && chmod -R a+rwX /opt/whisper-models
ENV HF_HUB_OFFLINE=1

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

COPY composer.json composer.lock ./
RUN composer install \
    --no-dev \
    --no-interaction \
    --no-scripts \
    --prefer-dist \
    --optimize-autoloader

COPY . .

RUN composer dump-autoload --no-dev --optimize --no-interaction \
    && mkdir -p \
        storage/app/private \
        storage/app/public \
        storage/framework/cache/data \
        storage/framework/sessions \
        storage/framework/views \
        storage/logs \
        bootstrap/cache \
    && chmod -R a+rwX storage bootstrap/cache \
    && chmod +x docker/heroku/*.sh

COPY docker/php-production.ini /usr/local/etc/php/conf.d/production.ini
COPY docker/heroku/php.ini /usr/local/etc/php/conf.d/zz-heroku.ini
COPY docker/heroku/php-fpm.conf /usr/local/etc/php-fpm.d/zz-heroku.conf

CMD ["/var/www/html/docker/heroku/web.sh"]
