{$SITE_ADDRESS} {
    encode zstd gzip

    @backend path /api/* /up /storage/*
    handle @backend {
        reverse_proxy backend-web:8080
    }

    handle {
        reverse_proxy frontend:3000
    }

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options SAMEORIGIN
        -Server
    }

    log {
        output stdout
        format console
    }
}
