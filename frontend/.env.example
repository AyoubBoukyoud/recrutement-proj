# Laravel reste la source de vérité pour les données et l'authentification.
# Base de l'API appelée par le navigateur, figée au build :
#   - développement : `php artisan serve` écoute sur :8000 (README, SETUP,
#     docker-compose.yml). Si ce port est pris sur votre machine, servez l'API
#     ailleurs (`--port=8010`) et reportez-le dans votre .env.local ;
#   - production : `/api`, même origine derrière le reverse proxy (déjà fixé
#     par Dockerfile.prod, deploy/docker-compose.prod.yml et la CI).
# Un build de production sans cette variable échoue (next.config.mjs).
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_USE_MOCKS=0

# Opt-in strictement réservés au développement interne. Les laisser absents
# ou à 0 pour une démonstration client et en production.
NEXT_PUBLIC_SHOW_DEV_TOOLS=0
NEXT_PUBLIC_ENABLE_PROTOTYPES=0

# Web Push public key — matches backend/.env's VAPID_PUBLIC_KEY (safe to expose, it's the public half).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# « Continuer avec Google ». Affiche le bouton ; tout le protocole (secret,
# vérification du jeton) vit dans Laravel — voir GOOGLE_* dans backend/.env.
# N'activez que si le back est configuré, sinon le bouton répondra
# « indisponible ». Ignoré en mode maquette.
NEXT_PUBLIC_GOOGLE_SIGN_IN=0
